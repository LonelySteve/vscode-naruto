{
  "name": "naruto-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "compile": "pnpm --filter naruto compile && pnpm --filter mac-naruto-receiver compile",
    "check-types": "pnpm --filter naruto check-types",
    "lint": "pnpm --filter naruto lint",
    "watch": "pnpm --filter naruto watch",
    "package:vsix": "pnpm --filter naruto package:vsix",
    "package:mac": "pnpm --filter mac-naruto-receiver package",
    "start:mac": "pnpm --filter mac-naruto-receiver start",
    "test": "pnpm test:vscode && pnpm test:mac",
    "test:vscode": "pnpm --filter naruto test",
    "test:mac": "pnpm --filter mac-naruto-receiver test"
  }
}
