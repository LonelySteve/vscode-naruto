{
  "name": "naruto",
  "displayName": "naruto",
  "description": "",
  "version": "0.5.1",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "url": "https://github.com/LonelySteve/vscode-naruto"
  },
  "activationEvents": [
    "onCommand:naruto.compressText",
    "onCommand:naruto.decompressText",
    "onCommand:naruto.openCompressionWebview",
    "onView:naruto.virtualWorkspace",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "naruto.compressText",
        "title": "Compress Text in Editor"
      },
      {
        "command": "naruto.decompressText",
        "title": "Decompress Text in Editor"
      },
      {
        "command": "naruto.openCompressionWebview",
        "title": "Open Compression Webview"
      },
      {
        "command": "naruto.virtualWorkspace.add",
        "title": "添加到 Naruto 虚拟工作区",
        "icon": "$(add)"
      },
      {
        "command": "naruto.virtualWorkspace.addCurrentFile",
        "title": "将当前文件添加到 Naruto 虚拟工作区",
        "icon": "$(add)"
      },
      {
        "command": "naruto.virtualWorkspace.removeCurrentFile",
        "title": "将当前文件从 Naruto 虚拟工作区中移除",
        "icon": "$(remove)"
      },
      {
        "command": "naruto.virtualWorkspace.remove",
        "title": "从 Naruto 虚拟工作区中移除",
        "icon": "$(remove)"
      },
      {
        "command": "naruto.virtualWorkspace.newFile",
        "title": "新建文件",
        "icon": "$(new-file)"
      },
      {
        "command": "naruto.virtualWorkspace.newFolder",
        "title": "新建文件夹",
        "icon": "$(new-folder)"
      },
      {
        "command": "naruto.virtualWorkspace.rename",
        "title": "重命名",
        "icon": "$(edit)"
      },
      {
        "command": "naruto.virtualWorkspace.delete",
        "title": "删除真实文件或文件夹",
        "icon": "$(trash)"
      },
      {
        "command": "naruto.virtualWorkspace.refresh",
        "title": "刷新 Naruto 虚拟工作区",
        "icon": "$(refresh)"
      },
      {
        "command": "naruto.virtualWorkspace.clear",
        "title": "清空 Naruto 虚拟工作区",
        "icon": "$(clear-all)"
      },
      {
        "command": "naruto.virtualWorkspace.import",
        "title": "导入 Naruto 虚拟工作区",
        "icon": "$(cloud-download)"
      },
      {
        "command": "naruto.virtualWorkspace.export",
        "title": "导出 Naruto 虚拟工作区所选范围：复制下一块",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "naruto.virtualWorkspace.cancelExport",
        "title": "取消 Naruto 虚拟工作区导出",
        "icon": "$(close)"
      },
      {
        "command": "naruto.virtualWorkspace.exportFull",
        "title": "全量导出 Naruto 虚拟工作区",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "naruto.virtualWorkspace.setIncrementalMode",
        "title": "切换为增量导出模式",
        "toggled": "viewItem =~ /:incremental$/"
      },
      {
        "command": "naruto.virtualWorkspace.setFullMode",
        "title": "切换为全量导出模式",
        "toggled": "viewItem =~ /:full$/"
      },
      {
        "command": "naruto.virtualWorkspace.filter",
        "title": "按文件名筛选 Naruto 虚拟工作区",
        "icon": "$(filter)"
      },
      {
        "command": "naruto.virtualWorkspace.clearFilter",
        "title": "清除文件名筛选"
      },
      {
        "command": "naruto.virtualWorkspace.sortAdded",
        "title": "排序：按添加顺序",
        "toggled": "naruto.virtualWorkspace.sortOrder == added"
      },
      {
        "command": "naruto.virtualWorkspace.sortFiles",
        "title": "排序：按实际文件顺序",
        "toggled": "naruto.virtualWorkspace.sortOrder == files"
      }
    ],
    "configuration": {
      "title": "Naruto Extension Configuration",
      "properties": {
        "naruto.compression.chunkingEnabled": {
          "type": "boolean",
          "default": false,
          "description": "是否启用压缩结果分块"
        },
        "naruto.compression.chunkSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "压缩后分割块大小，单位字节，默认不分割"
        },
        "naruto.compression.source": {
          "type": [
            "string"
          ],
          "enum": [
            "askUser",
            "activeEditor",
            "clipboard"
          ],
          "enumItemLabels": [
            "询问用户选择",
            "当前活动编辑器",
            "剪贴板"
          ],
          "default": "askUser",
          "description": "压缩源位置，默认情况将询问用户选择"
        },
        "naruto.decompression.source": {
          "type": [
            "string"
          ],
          "enum": [
            "askUser",
            "activeEditor",
            "clipboard"
          ],
          "enumItemLabels": [
            "询问用户选择",
            "当前活动编辑器",
            "剪贴板"
          ],
          "default": "askUser",
          "description": "解压源位置，默认情况将询问用户选择"
        },
        "naruto.virtualWorkspace.chunkSize": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "description": "虚拟工作区压缩文本的数据分块大小（字节）。首次导出复制起始元信息，后续每次点击仅复制一个数据块；元信息始终完整复制。"
        },
        "naruto.virtualWorkspace.deleteRemoved": {
          "type": "boolean",
          "default": true,
          "description": "增量导出时，为从虚拟工作区移除的资源生成 delete 操作。关闭后仅为真实路径已不存在的资源生成删除操作。不会删除发送端真实文件。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "naruto",
          "title": "Naruto",
          "icon": "resources/naruto.svg"
        }
      ]
    },
    "views": {
      "naruto": [
        {
          "id": "naruto.virtualWorkspace",
          "name": "虚拟工作区",
          "contextualTitle": "Naruto",
          "icon": "resources/naruto.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "naruto.virtualWorkspace",
        "contents": "在资源管理器中右键文件或文件夹，或右键文件 Tab，选择“添加到 Naruto 虚拟工作区”。\n这里的编辑、新建、重命名和删除会直接应用到真实工作区。\n[添加当前文件](command:naruto.virtualWorkspace.addCurrentFile)",
        "when": "!naruto.virtualWorkspace.filterActive"
      },
      {
        "view": "naruto.virtualWorkspace",
        "when": "naruto.virtualWorkspace.filterActive",
        "contents": "没有匹配的文件。\n[更改筛选](command:naruto.virtualWorkspace.filter) · [清除筛选](command:naruto.virtualWorkspace.clearFilter)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "naruto.virtualWorkspace.add",
          "when": "isFileSystemResource && resourceScheme != untitled && resource not in naruto.virtualWorkspace.resources",
          "group": "naruto@1"
        },
        {
          "command": "naruto.virtualWorkspace.remove",
          "when": "resource in naruto.virtualWorkspace.resources",
          "group": "naruto@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "naruto.virtualWorkspace.add",
          "when": "isFileSystemResource && resourceScheme != untitled && resource not in naruto.virtualWorkspace.resources",
          "group": "naruto@1"
        },
        {
          "command": "naruto.virtualWorkspace.remove",
          "when": "resource in naruto.virtualWorkspace.resources",
          "group": "naruto@2"
        }
      ],
      "commandPalette": [
        {
          "command": "naruto.virtualWorkspace.add",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.remove",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.rename",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.delete",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.newFile",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.newFolder",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.setIncrementalMode",
          "when": "false"
        },
        {
          "command": "naruto.virtualWorkspace.setFullMode",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "naruto.virtualWorkspace.newFile",
          "when": "view == naruto.virtualWorkspace",
          "group": "1_create@1"
        },
        {
          "command": "naruto.virtualWorkspace.newFolder",
          "when": "view == naruto.virtualWorkspace",
          "group": "1_create@2"
        },
        {
          "command": "naruto.virtualWorkspace.import",
          "when": "view == naruto.virtualWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "naruto.virtualWorkspace.export",
          "when": "view == naruto.virtualWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "naruto.virtualWorkspace.refresh",
          "when": "view == naruto.virtualWorkspace",
          "group": "3_actions@1"
        },
        {
          "command": "naruto.virtualWorkspace.clear",
          "when": "view == naruto.virtualWorkspace",
          "group": "4_manage@1"
        },
        {
          "command": "naruto.virtualWorkspace.filter",
          "when": "view == naruto.virtualWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "naruto.virtualWorkspace.sortAdded",
          "when": "view == naruto.virtualWorkspace",
          "group": "2_sort@1"
        },
        {
          "command": "naruto.virtualWorkspace.sortFiles",
          "when": "view == naruto.virtualWorkspace",
          "group": "2_sort@2"
        },
        {
          "command": "naruto.virtualWorkspace.clearFilter",
          "when": "view == naruto.virtualWorkspace && naruto.virtualWorkspace.filterActive",
          "group": "3_actions@2"
        }
      ],
      "view/item/context": [
        {
          "command": "naruto.virtualWorkspace.export",
          "when": "view == naruto.virtualWorkspace",
          "group": "inline@1"
        },
        {
          "command": "naruto.virtualWorkspace.newFile",
          "when": "view == naruto.virtualWorkspace",
          "group": "1_create@1"
        },
        {
          "command": "naruto.virtualWorkspace.newFolder",
          "when": "view == naruto.virtualWorkspace",
          "group": "1_create@2"
        },
        {
          "command": "naruto.virtualWorkspace.rename",
          "when": "view == naruto.virtualWorkspace && !(viewItem =~ /^workspaceRoot:/)",
          "group": "2_modify@1"
        },
        {
          "command": "naruto.virtualWorkspace.delete",
          "when": "view == naruto.virtualWorkspace && !(viewItem =~ /^workspaceRoot:/)",
          "group": "2_modify@2"
        },
        {
          "command": "naruto.virtualWorkspace.remove",
          "when": "view == naruto.virtualWorkspace",
          "group": "3_selection@1"
        },
        {
          "command": "naruto.virtualWorkspace.setIncrementalMode",
          "when": "view == naruto.virtualWorkspace",
          "group": "7_export@1"
        },
        {
          "command": "naruto.virtualWorkspace.setFullMode",
          "when": "view == naruto.virtualWorkspace",
          "group": "7_export@2"
        }
      ]
    }
  },
  "scripts": {
    "build:skill": "node scripts/build-import-skill.mjs",
    "fixtures:receiver": "node scripts/receiver-fixtures.mjs",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "package:vsix": "pnpm run package && pnpm exec vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.72.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "compress-brotli": "^1.3.13"
  }
}
